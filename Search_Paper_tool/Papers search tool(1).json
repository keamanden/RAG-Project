        "jsCode": "const vectorRows =\n  $('Vector Search').first().json.results?.[0]?.data ?? [];\n\nconst graphRows =\n  $('Graph Lookup').first().json.results?.[0]?.data ?? [];\n\nconst categories = new Map(\n  graphRows.map(({ row }) => [row[0], row[2]])\n);\n\nreturn [\n  {\n    json: {\n      papers: vectorRows.map(({ row }) => ({\n        id: row[0],\n        title: row[1],\n        abstract: row[2],\n        score: row[3],\n        category: categories.get(row[0]) ?? null\n      }))\n    }\n  }\n];"
