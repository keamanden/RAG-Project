      "id": "8e960e71-efc1-415b-a2c1-733bcee553f3",
      "name": "Extract academic papers"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map((item, index) => {\n  const fields = Object.fromEntries(Object.entries(item.json).map(([key, value]) => [key.toLowerCase().replace(/[^a-z0-9]/g, ''), value]));\n  const rawId = fields.id ?? fields.paperid ?? fields.arxivid ?? fields.doi;\n  const id = String(rawId ?? '').trim();\n  if (!id) throw new Error(`Missing paper ID in CSV row ${index + 1}; check the CSV ID column header.`);\n\n  const rawTitle = fields.title ?? '';\n  const rawAbstract = fields.abstract ?? '';\n  const rawCategory = fields.primarycategory ?? fields.category ?? '';\n  return {\n    json: {\n      id,\n      title: String(rawTitle).trim(),\n                          abstract: String(rawAbstract).replace(/[\\r\\n]+/g, ' ').trim(),\n      category: String(rawCategory).trim()\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5232,
        928
      ],
      "id": "418c9061-23f1-402b-b4f4-46931ae287fd",
      "name": "Map and trim"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ollama:11434/api/embeddings",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: \"nomic-embed-text\", prompt: $json.abstract } }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        5680,
        928
      ],
      "id": "59d08e63-6769-498b-912e-43aceb8befcb",
      "name": "Embed"
    },
    {
      "parameters": {
        "jsCode": "const original = $('Loop Over Items').item.json;\nconst embedding = $json.embedding ?? $json.body?.embedding;\nif (!Array.isArray(embedding) || embedding.length === 0) {\n  throw new Error(`Missing embedding for paper ${original.id}.`);\n}\n\nreturn [{\n  json: {\n    id: original.id,\n    title: original.title,\n    abstract: original.abstract,\n    category: original.category,\n    embedding\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        6128,
        928
      ],
      "id": "10f2bbce-3d95-49f4-a16a-b0dc5f5cb198",
      "name": "Map to JSON object"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:7474/db/vector/tx/commit",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { statements: [{ statement: \"MERGE (p:Paper {id: $id}) SET p.title = $title, p.abstract = $abstract, p.category = $category, p.embedding = $embedding RETURN p.id AS saved_id\", parameters: { id: $json.id, title: $json.title, abstract: $json.abstract, category: $json.category, embedding: $json.embedding } }] } }}",
        "options": {}
      },
