        "method": "POST",
        "url": "http://host.docker.internal:7474/db/vector/tx/commit",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { statements: [{ statement: \"MERGE (a:Paper {id: $id}) SET a.title = $title, a.abstract = $abstract WITH a, CASE WHEN $category IS NULL OR trim($category) = '' THEN null ELSE trim($category) END AS categoryName FOREACH (_ IN CASE WHEN categoryName IS NULL THEN [] ELSE [1] END | MERGE (c:Category {name: categoryName}) MERGE (a)-[:IN_CATEGORY]->(c)) RETURN a.id AS saved_id\", parameters: { id: $json.id, title: $json.title, abstract: $json.abstract, category: $json.category } }] } }}",
